{
  "name": "@ajaxjs/aj-workflow-designer-vue3",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist-lib/aj-workflow-designer.umd.cjs",
  "module": "./dist-lib/aj-workflow-designer.es.js",
  "types": "./dist-lib/types/lib.d.ts",
  "style": "./dist-lib/aj-workflow-designer.css",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib.d.ts",
      "import": "./dist-lib/aj-workflow-designer.es.js",
      "require": "./dist-lib/aj-workflow-designer.umd.cjs"
    },
    "./style.css": "./dist-lib/aj-workflow-designer.css"
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "build:all": "npm run build && npm run build:lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check src tests vite.config.ts vite.lib.config.ts",
    "format": "biome check --write src tests vite.config.ts vite.lib.config.ts"
  },
  "dependencies": {
    "raphael": "^2.3.0"
  },
  "peerDependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.13.3",
    "@types/raphael": "^2.3.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^30.0.1",
    "less": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  }
}
